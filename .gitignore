# Environment / secrets
.env
.env.*
!.env.example
!.env.test.example
*.pem
*.key

# Dependencies / build output
node_modules/
dist/
dist-ssr/
venv/
__pycache__/
*.pyc

# Backups gerados pelo backup automático do banco (backend/backup.py) — em
# dev fica em backend/backups/ por padrão; nunca faz sentido versionar um
# dump do banco.
backend/backups/

# Build publicado da intranet (gerado a partir de intranet-app/ com
# `npm run build` — não é código-fonte, não faz sentido versionar).
/site/intranet/
# Pasta antiga (pré-reorganização) — pode ser removida manualmente do disco.
/intranet/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Worktrees temporários criados por subagentes do Claude Code — sessão local, não é código.
/.claude/

# Arquivos de lock temporários do Word/Excel/PowerPoint (criados enquanto
# o arquivo está aberto — nunca é conteúdo de verdade).
~$*
