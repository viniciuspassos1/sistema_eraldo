# Copie para .env (já está no .gitignore).
# Aponta o frontend para o backend local em backend/ — serve tanto o Meu
# Authenticator quanto o Assistente IA (mesmo servidor, mesma porta).
# Precisa bater com o API_KEY configurado em backend/.env.
VITE_AUTHENTICATOR_API_URL=http://localhost:8010
VITE_AUTHENTICATOR_API_KEY=dev-local-key-12345
