# Copie para ".env" (raiz do projeto) — usado só pelo docker-compose.yml na
# hora do deploy. Segredos do backend (banco, JWT_SECRET, SMTP, Gemini) vão
# em backend/.env, não aqui — ver backend/.env.example.

# Domínio real (com DNS já apontando pro IP da VPS) — o Caddy usa isso pra
# emitir e renovar sozinho o certificado HTTPS (Let's Encrypt). Em teste
# local, deixe em branco (usa "localhost", sem HTTPS).
SITE_DOMAIN=intranet.proferaldojunior.com.br

# Mesmo valor do API_KEY definido em backend/.env — é a chave que o
# frontend (já compilado, estático) manda em todo request pro backend.
VITE_AUTHENTICATOR_API_KEY=troque-por-uma-chave-aleatoria-forte

# Deixe em branco: com o Caddy fazendo proxy de /api/* pro backend no mesmo
# domínio, o frontend chama a API com caminho relativo (mesma origem) —
# não precisa apontar pra uma URL separada.
VITE_AUTHENTICATOR_API_URL=
