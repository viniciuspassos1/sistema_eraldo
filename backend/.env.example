# Copie este arquivo para .env (o .env já está no .gitignore, nunca sobe pro git).

# Chave que o frontend precisa enviar no header X-API-Key.
# Gere qualquer valor aleatório forte, ex: openssl rand -hex 32
API_KEY=troque-por-uma-chave-aleatoria-forte

# Um serviço por bloco. O SECRET é a "chave secreta" em texto que o site
# mostra no momento em que você ativa um 2FA novo (geralmente embaixo do
# QR code, formato tipo "JBSW Y3DP EHPK 3PXP"). Não funciona com um app
# Authenticator que já foi configurado antes — o segredo só existe nesse
# momento inicial de cadastro.
AUTH_SERVICE_1_NAME=Minha conta de teste
AUTH_SERVICE_1_SECRET=JBSWY3DPEHPK3PXP

# Para adicionar mais serviços, use AUTH_SERVICE_2_NAME / AUTH_SERVICE_2_SECRET, etc.

# String de conexão do banco Postgres (Supabase). Pegue em:
# Supabase → seu projeto → Project Settings → Database → Connection string → URI
# (use a versão "Connection pooling" se for rodar em serverless; a direta
# funciona bem para um backend tradicional tipo este, sempre ligado).
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:sua-senha@db.xxxxxxxx.supabase.co:5432/postgres

# Chave usada para assinar o token de sessão (login) — obrigatória.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Nunca reaproveite a mesma chave entre ambientes (dev/produção).
JWT_SECRET=troque-por-uma-chave-aleatoria-forte

# Por quanto tempo o token de login vale. SESSAO é usado quando a pessoa
# não marca "Manter conectado" (padrão 12h); PERSISTENTE quando marca
# (padrão 720h = 30 dias). Opcionais — têm valor padrão se omitidos.
JWT_EXPIRES_HOURS_SESSAO=12
JWT_EXPIRES_HOURS_PERSISTENTE=720
